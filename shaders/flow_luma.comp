#version 450
// Stage 4, pyramid level 1: luma of the ring image, 2x2 box average (half resolution, sizes round up, reads clamp to the edge).
// Mirrors flowref::Down on a luma image (include/flow_ref.hpp).
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly  image2D u_src;
layout(set = 0, binding = 1, r32f)    uniform writeonly image2D u_dst;

float luma(ivec2 q, ivec2 m) {
    return dot(imageLoad(u_src, min(q, m)).rgb, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(u_dst)))) return;
    ivec2 m = imageSize(u_src) - 1;
    ivec2 s = p * 2;
    float l = luma(s, m) + luma(s + ivec2(1, 0), m) + luma(s + ivec2(0, 1), m) + luma(s + ivec2(1, 1), m);
    imageStore(u_dst, p, vec4(l * 0.25, 0.0, 0.0, 0.0));
}

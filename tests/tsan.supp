# ThreadSanitizer suppressions for the ctest runs (-DFRAMEGEN_SANITIZER=thread).
# The mock drivers in tests/test_*.cpp record what the layer calls in plain globals and vectors (r_submits, r_events, ...). The mock functions run on the layer's
# presenter thread and the test's main thread reads the records afterwards without a lock: a race in the test harness, not in the layer. A report is hidden only
# when one of the mock functions below is a frame of it; a race between two layer functions has none of them and still fails the test.
race:^m_Acquire$
race:^m_Alloc$
race:^m_AllocCb$
race:^m_AllocSets$
race:^m_Barrier2$
race:^m_Begin$
race:^m_Bind$
race:^m_BindPipe$
race:^m_BindSets$
race:^m_Blit$
race:^m_Calib$
race:^m_Caps$
race:^m_Caps2$
race:^m_CreateCompute$
race:^m_CreateDescPool$
race:^m_CreateDevice$
race:^m_CreateFence$
race:^m_CreateImage$
race:^m_CreateInstance$
race:^m_CreatePipeLayout$
race:^m_CreatePool$
race:^m_CreateSem$
race:^m_CreateSetLayout$
race:^m_CreateShader$
race:^m_CreateSwapchain$
race:^m_CreateView$
race:^m_DestroyDescPool$
race:^m_DestroyDevice$
race:^m_DestroyFence$
race:^m_DestroyImage$
race:^m_DestroyInstance$
race:^m_DestroyPipeLayout$
race:^m_DestroyPipeline$
race:^m_DestroyPool$
race:^m_DestroySem$
race:^m_DestroySetLayout$
race:^m_DestroyShader$
race:^m_DestroySwapchain$
race:^m_DestroyView$
race:^m_Dispatch$
race:^m_Domains$
race:^m_End$
race:^m_EnumDevExt$
race:^m_EnumInstExt$
race:^m_Features2$
race:^m_FormatProps$
race:^m_Free$
race:^m_GetQueue$
race:^m_ImgReq$
race:^m_MemProps$
race:^m_Past$
race:^m_Present$
race:^m_PushConst$
race:^m_QFProps$
race:^m_QueueSubmit1$
race:^m_QueueWaitIdle$
race:^m_ResetCb$
race:^m_ResetFences$
race:^m_SetLoaderData$
race:^m_SetQueue$
race:^m_Submit2$
race:^m_SwapImages$
race:^m_Unknown$
race:^m_UpdateSets$
race:^m_WaitFences$
race:^m_WaitIdle$

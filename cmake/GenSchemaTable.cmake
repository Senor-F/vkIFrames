# Generates ${OUT} (a C++ table) from decky/settings_schema.json with CMake's own JSON support (CMake 3.19+): one row per setting the Decky panel shows.
# Used by the build test that compares the panel's defaults and ranges with the layer's.
file(READ "${SCHEMA}" _json)
string(JSON _n LENGTH "${_json}")
math(EXPR _last "${_n} - 1")
set(_rows "")
foreach(_i RANGE ${_last})
    string(JSON _key GET "${_json}" ${_i} key)
    string(JSON _type GET "${_json}" ${_i} type)
    string(JSON _needs GET "${_json}" ${_i} needsLayer)
    string(JSON _def GET "${_json}" ${_i} default)
    string(JSON _min ERROR_VARIABLE _e GET "${_json}" ${_i} min)
    if(_e OR _min STREQUAL "")
        set(_min 0)
    endif()
    string(JSON _max ERROR_VARIABLE _e GET "${_json}" ${_i} max)
    if(_e OR _max STREQUAL "")
        set(_max 1)
    endif()
    if(_type STREQUAL "toggle")
        set(_toggle true)
    else()
        set(_toggle false)
    endif()
    if(_needs STREQUAL "live")
        set(_live true)
    else()
        set(_live false)
    endif()
    string(APPEND _rows "    {\"${_key}\", ${_toggle}, ${_live}, ${_min}, ${_max}, ${_def}},\n")
endforeach()
file(WRITE "${OUT}.tmp" "// Generated from decky/settings_schema.json by cmake/GenSchemaTable.cmake. Do not edit.\n#pragma once\nstruct SchemaRow { const char* key; bool toggle; bool live; double lo, hi, def; };\ninline constexpr SchemaRow kSchema[] = {\n${_rows}};\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
